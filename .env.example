# Copia este archivo a .env y rellena los valores del proyecto de Supabase (Settings → API).
# La clave publishable es pública por diseño (va dentro de la app); el acceso a los datos lo
# controlan las reglas RLS (supabase/migrations). Nunca pongas aquí la clave secreta.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
