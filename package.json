{
  "name": "bitacora",
  "private": true,
  "version": "0.1.0",
  "description": "Bitácora: gestión personal de proyectos y tareas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios": "npm run build && cap sync ios",
    "ios:abrir": "cap open ios",
    "db:push": "supabase db push --linked",
    "db:config": "supabase config push --project-ref gpneajxkshorrwwuljfo"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
